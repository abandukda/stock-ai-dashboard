{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Phase 4B point-in-time calibration observation",
  "type": "object",
  "required": [
    "scan_commit_sha", "scan_timestamp", "observation_date", "ticker",
    "price", "price_provenance", "forward_pe", "forward_pe_provenance",
    "forward_eps", "forward_eps_method", "forward_eps_provenance",
    "revenue_growth", "revenue_growth_provenance", "formula_version",
    "atlas_fv_status"
  ],
  "properties": {
    "scan_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scan_timestamp": {"type": "string", "format": "date-time"},
    "observation_date": {"type": "string", "format": "date"},
    "ticker": {"type": "string"},
    "sector": {"type": ["string", "null"]},
    "industry": {"type": ["string", "null"]},
    "price": {"type": ["number", "null"]},
    "price_provenance": {"type": ["string", "null"]},
    "forward_pe": {"type": ["number", "null"]},
    "forward_pe_provenance": {"type": ["string", "null"]},
    "forward_eps": {"type": ["number", "null"]},
    "forward_eps_method": {"enum": ["PROVIDER_DIRECT", "DERIVED_FROM_CONTEMPORANEOUS_PRICE_AND_PE", "UNAVAILABLE"]},
    "forward_eps_provenance": {"type": ["string", "null"]},
    "revenue_growth": {"type": ["number", "null"]},
    "revenue_growth_provenance": {"type": ["string", "null"]},
    "operating_margin": {"type": ["number", "null"]},
    "operating_margin_provenance": {"type": ["string", "null"]},
    "formula_version": {"type": "string"},
    "justified_pe": {"type": ["number", "null"]},
    "required_multiple_expansion": {"type": ["number", "null"]},
    "raw_atlas_fv": {"type": ["number", "null"]},
    "raw_atlas_upside": {"type": ["number", "null"]},
    "atlas_fv_status": {"type": "string"},
    "published_atlas_fv": {"type": ["number", "null"]},
    "rejection_reason": {"type": ["string", "null"]},
    "return_1m": {"type": ["number", "null"]},
    "return_3m": {"type": ["number", "null"]},
    "spy_return_1m": {"type": ["number", "null"]},
    "spy_return_3m": {"type": ["number", "null"]},
    "excess_spy_1m": {"type": ["number", "null"]},
    "excess_spy_3m": {"type": ["number", "null"]},
    "sector_benchmark": {"type": ["string", "null"]},
    "sector_return_1m": {"type": ["number", "null"]},
    "sector_return_3m": {"type": ["number", "null"]},
    "excess_sector_1m": {"type": ["number", "null"]},
    "excess_sector_3m": {"type": ["number", "null"]}
  },
  "additionalProperties": true
}
